function [q1, q2, q3, GJ] = shear_flow(q_b1, q_b2, A1, A2, A3, delta_1, delta_2, delta_3, delta_12, delta_23, d1, d2, h_1_2, h_2_3, x_E, T)
M = [(delta_1+delta_12)/2/A1 -delta_12/2/A1 0 -1;...
    -delta_12/2/A2 delta_2/2/A2 -delta_23/2/A2 -1;...
    0 -delta_23/2/A3 delta_3/2/A3 -1;...
    2*A1 2*A2 2*A3 0];
Qb = [-q_b1*delta_12;...
    q_b1*delta_12-q_b2*delta_23;...
    q_b2*delta_23;...
    -q_b2*h_2_3*(d2-x_E)-q_b1*h_1_2*(d1-x_E)+T];
Q = M\Qb;
q1 = Q(1);
q2 = Q(2);
q3 = Q(3);
Q0 = M\[0;0;0;T];
twist = Q0(4);
GJ = T/twist;
